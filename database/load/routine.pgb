-- A routine edited (renamed back and forth).
\set n random(:lo, :hi)
\set r random(1, 1000)
select set_config('request.jwt.claim.sub', id::text, false) from lt_people where n = :n;
select s.* from lt_people p, public.forma_save_changes(jsonb_build_array(jsonb_build_object('k', 'routines', 'i', p.routine->'id', 'v', p.routine || jsonb_build_object('name', 'Upper 1 v' || :r))),
  (select revision from public.forma_workspaces where user_id = p.id)) s where p.n = :n;
