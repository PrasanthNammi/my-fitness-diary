{
  "name": "forma-fitness",
  "version": "1.0.0",
  "description": "Private fitness tracking with Supabase accounts and cloud workspace sync",
  "main": "index.js",
  "scripts": {
    "build:client": "esbuild src/supabase-client.js --bundle --minify --format=iife --platform=browser --outfile=public/legacy/vendor/supabase.js",
    "build:barcode": "esbuild src/barcode-client.js --bundle --minify --format=iife --platform=browser --outfile=public/legacy/vendor/barcode.js",
    "build": "node scripts-build-react.cjs && node scripts-build-hosting.cjs",
    "test:performance": "node tests/run-performance.cjs",
    "dev": "node scripts-build-react.cjs && node scripts-prepare-dev.cjs && npm --prefix hosting run dev",
    "test:local": "node tests/run-local-checks.cjs",
    "test:mcp": "node tests/mcp-server.cjs && node tests/mcp-database.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@zxing/browser": "0.2.1",
    "lucide-react": "1.59.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.0.0"
  },
  "private": true
}
