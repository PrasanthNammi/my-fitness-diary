# Reference scrape jobs; Grafana Cloud runs the equivalent hosted jobs.
# Store a monitoring-only token in a mounted secret, never in this repository.
global:
  scrape_interval: 60s
  evaluation_interval: 60s
rule_files:
  - prometheus-alerts.yml
scrape_configs:
  - job_name: mfd-sync
    scheme: https
    metrics_path: /functions/v1/mfd-metrics
    scrape_timeout: 15s
    basic_auth:
      username: metrics
      password_file: /run/secrets/mfd_metrics_token
    static_configs:
      - targets: [djyozltkmbzhwuvemxuy.supabase.co:443]
