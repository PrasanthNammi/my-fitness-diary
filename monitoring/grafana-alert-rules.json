    "folderUID": "fdwrsn",
    "ruleGroup": "mfd-sync",
    "condition": "C",
    "for": "2m",
    "noDataState": "Alerting",
    "execErrState": "Alerting",
    "labels": {
      "severity": "critical",
      "app": "mfd"
    },
    "annotations": {
      "summary": "Database rollback storm",
      "description": "Check RPC errors; business conflicts must never use SQLSTATE 40001."
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "refId": "A",
          "expr": "sum(rate(mfd_db_transactions_total{outcome=\"rollback\"}[5m])) > bool 1",
          "instant": true,
          "range": false
        }
      },
      {
        "refId": "C",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ]
        }
      }
    ],
    "isPaused": false
  },
  {
    "uid": "mfdslowsaves",
    "title": "Save operations average over one second",
    "folderUID": "fdwrsn",
    "ruleGroup": "mfd-sync",
    "condition": "C",
    "for": "5m",
    "noDataState": "Alerting",
    "execErrState": "Alerting",
    "labels": {
      "severity": "warning",
      "app": "mfd"
    },
    "annotations": {
      "summary": "Save operations average over one second",
      "description": "Inspect connection saturation and slow queries."
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "refId": "A",
          "expr": "sum(rate(mfd_sync_duration_seconds_sum[5m])) / clamp_min(sum(rate(mfd_sync_operations_total[5m])), 0.000001) > bool 1",
          "instant": true,
          "range": false
        }
      },
      {
        "refId": "C",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ]
        }
      }
    ],
    "isPaused": false
  },
