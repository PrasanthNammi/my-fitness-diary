  {
    "uid": "mfdauthemailfailing",
    "title": "MFD \u2014 Sign-up emails failing",
    "folderUID": "fdwrsn",
    "ruleGroup": "mfd-sync",
    "condition": "C",
    "for": "0s",
    "noDataState": "OK",
    "execErrState": "Error",
    "labels": {
      "severity": "warning",
      "app": "mfd"
    },
    "annotations": {
      "summary": "MFD could not send a sign-up or password-reset email.",
      "description": "Supabase failed to send at least one MFD email (sign-up confirmation, password reset or resend) in the last hour, so email sign-ups and password resets are failing. Most likely cause: the MFD Gmail app password stopped working (26 Nov 2026). Check Supabase auth logs for /signup errors (\"535 Username and Password not accepted\"), then create a new app password at myaccount.google.com/apppasswords and paste it into Supabase > Authentication > Emails > SMTP Settings. Google sign-in is unaffected."
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 3600,
          "to": 0
        },
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "refId": "A",
          "expr": "sum(increase(mfd_auth_email_failures_total[1h]))",
          "instant": true,
          "range": false
        }
      },
      {
        "refId": "C",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0
                ]
              }
            }
          ]
        }
      }
    ]
  }
]
