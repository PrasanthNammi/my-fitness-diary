[
  {
    "uid": "mfdsyncconflictburst",
    "title": "Repeated save conflicts",
    "folderUID": "fdwrsn",
    "ruleGroup": "mfd-sync",
    "condition": "C",
    "for": "1m",
    "noDataState": "Alerting",
    "execErrState": "Alerting",
    "labels": {
      "severity": "warning",
      "app": "mfd"
    },
    "annotations": {
      "summary": "Repeated save conflicts",
      "description": "Inspect competing tabs, stale revisions and reconciliation; preserve local data."
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "grafanacloud-prom",
        "model": {
          "refId": "A",
          "expr": "sum(increase(mfd_sync_operations_total{outcome=\"conflict\"}[5m])) > bool 10",
          "instant": true,
          "range": false
        }
      },
      {
        "refId": "C",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query"
            }
          ]
        }
      }
    ],
    "isPaused": false
  },
