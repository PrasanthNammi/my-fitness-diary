[
 {
  "uid": "mfdconnectorexceededcpu",
  "title": "AI connector stopped for exceeding CPU",
  "folderUID": "fdwrsn",
  "ruleGroup": "mfd-connector",
  "condition": "C",
  "for": "0s",
  "noDataState": "OK",
  "execErrState": "KeepLast",
  "labels": {
   "severity": "warning",
   "app": "mfd"
  },
  "annotations": {
   "summary": "AI connector stopped for exceeding CPU",
   "description": "Cloudflare stopped connector requests for exceeding the free plan's CPU/memory limits in the last hour. AI calls failed and were not billed. Check the CPU panel; if regular, slim the connector bundle."
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 3600,
     "to": 0
    },
    "datasourceUid": "CLOUDFLARE_INFINITY_UID",
    "model": {
     "refId": "A",
     "type": "graphql",
     "source": "url",
     "parser": "backend",
     "format": "table",
     "url": "https://api.cloudflare.com/client/v4/graphql",
     "url_options": {
      "method": "POST",
      "body_type": "graphql",
      "body_content_type": "application/json",
      "body_graphql_query": "query($a:string!,$w:[string!]){viewer{accounts(filter:{accountTag:$a}){workersInvocationsAdaptive(limit:2000,filter:{scriptName_in:$w,datetime_geq:\"${__timeFrom:date:iso}\",datetime_leq:\"${__timeTo:date:iso}\",status:\"exceededResources\"}){sum{requests} dimensions{scriptName}}}}}",
      "body_graphql_variables": "{\"a\": \"fa8205077c4bc4d2bb38ee035e74a156\", \"w\": [\"mfd-connect-staging\", \"mfd-connect\"]}"
     },
     "root_selector": "data.viewer.accounts[0].workersInvocationsAdaptive",
     "columns": [
      {
       "selector": "dimensions.scriptName",
       "text": "worker",
       "type": "string"
      },
      {
       "selector": "sum.requests",
       "text": "value",
       "type": "number"
      }
     ]
    }
   },
   {
    "refId": "B",
    "relativeTimeRange": {
     "from": 0,
     "to": 0
    },
    "datasourceUid": "__expr__",
    "model": {
     "refId": "B",
     "type": "reduce",
     "expression": "A",
     "reducer": "max",
     "settings": {
      "mode": "dropNN"
     }
    }
   },
   {
    "refId": "C",
    "relativeTimeRange": {
     "from": 0,
     "to": 0
    },
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "B",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         0
        ]
       }
      }
     ]
    }
   }
  ],
  "isPaused": false
 },
